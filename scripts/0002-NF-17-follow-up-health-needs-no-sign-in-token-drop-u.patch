From ca8439c9dbef5931ecef75a6e2e547165cacef22 Mon Sep 17 00:00:00 2001
From: sosa <noreply@example.invalid>
Date: Sat, 21 Nov 2026 11:41:15 +0000
Subject: [PATCH 2/2] NF-17 follow-up: health needs no sign-in token, drop
 unused email from Caller

- supabase/config.toml: [functions.health] verify_jwt = false, so the uptime
  monitor is not refused with 401 after a normal deploy.
- _shared/auth.ts: remove Caller.email. Nothing used it, and the caller object
  is passed next to the error reporting, which must never carry an email.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016PyR3W6Fe4SN2RynqktYzo
---
 supabase/config.toml               | 4 ++++
 supabase/functions/_shared/auth.ts | 3 ---
 supabase/functions/health/index.ts | 5 ++---
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/supabase/config.toml b/supabase/config.toml
index 75aca14..3f42766 100644
--- a/supabase/config.toml
+++ b/supabase/config.toml
@@ -416,3 +416,7 @@ enabled = true
 # formatted with uppercase keywords, indent 2, max width 180, trailing commas,
 # and column/key alignment. Set to "null" to emit raw, unformatted SQL.
 # format_options = "{\"keywordCase\":\"upper\",\"indent\":2,\"maxWidth\":180,\"commaStyle\":\"trailing\"}"
+
+# NF-17.3: the uptime monitor calls health without a sign-in token.
+[functions.health]
+verify_jwt = false
diff --git a/supabase/functions/_shared/auth.ts b/supabase/functions/_shared/auth.ts
index 4d718a6..20a1d1f 100644
--- a/supabase/functions/_shared/auth.ts
+++ b/supabase/functions/_shared/auth.ts
@@ -24,8 +24,6 @@ export interface FilesReader {
 
 export interface Caller extends TokenClaims {
   userId: string;
-  /** The signed-in user's own email. Use it for that user only; never log or tag it. */
-  email?: string;
   /** For uploadFile / getDownloadUrl. */
   client: StorageClient;
   /** For reading public.files rows. Same underlying client. */
@@ -65,7 +63,6 @@ export async function authenticate(req: Request): Promise<Caller> {
   return {
     ...claims,
     userId: data.user.id,
-    email: data.user.email ?? undefined,
     client: supabase as unknown as StorageClient,
     db: supabase as unknown as FilesReader,
   };
diff --git a/supabase/functions/health/index.ts b/supabase/functions/health/index.ts
index e517c57..452fba9 100644
--- a/supabase/functions/health/index.ts
+++ b/supabase/functions/health/index.ts
@@ -2,9 +2,8 @@
 // running AND the Supabase auth service answers; 503 means one of them is down.
 // It returns nothing about the project, users or schools.
 //
-// Deploy without JWT verification so the monitor needs no key:
-//   supabase functions deploy health --no-verify-jwt
-// (or add  [functions.health] verify_jwt = false  to supabase/config.toml)
+// Runs without JWT verification so the monitor needs no key:
+// [functions.health] verify_jwt = false in supabase/config.toml.
 
 const headers = { "Content-Type": "application/json", "Cache-Control": "no-store" };
 
